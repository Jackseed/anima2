{
  "name": "anima",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-anima",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:engine": "npm --prefix engine test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-anima \"vitest run -c vitest.rules.config.mts tests/rules\"",
    "cap:sync": "ng build && cap sync",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-anima \"vitest run -c vitest.rules.config.mts tests/bot/e2e\"",
    "bot": "vitest run -c vitest.rules.config.mts tests/bot/play-against",
    "scenario": "vitest run -c vitest.rules.config.mts tests/bot/scenario"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@panzoom/panzoom": "^4.6.2",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
